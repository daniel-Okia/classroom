# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=            # Supabase transaction pooler (6543) as app_user.<project-ref>
MIGRATE_DATABASE_URL=    # Supabase session pooler (5432) as postgres; migrations/seed only, NOT needed on Vercel
APP_USER_PASSWORD=       # password for the app_user role
AUTH_SECRET=             # openssl rand -hex 32
DEMO_SHOW_OTP=           # 1 on demo deployments only: shows the sign-in code on screen (ignored once AT_API_KEY is set)
AT_USERNAME=             # Africa's Talking (real SMS)
AT_API_KEY=
ALLOW_DRAFT_DEVOTIONS=   # 1 to serve unreviewed devotions outside production (demo only)
